                     ; Output one character byte to printer
3ABA  F5       .                   push  af             ; Save character on stack
3ABB  CDE83A   ..:                 call  CHECK_BREAK    ; Check BREAK key
3ABE  D2C43A   ..:                 jp    nc,0x3AC4      ; If BREAK pressed, return
3AC1  F1       .                   pop   af             ; Restore character from stack
3AC2  37       7                   scf                  ; Set Carry flag (BREAK)
3AC3  C9       .                   ret                  ; Return with BREAK error
3AC4  DB00     ..                  in    a,(0x00)       ; Read printer port (port 0)
3AC6  CB47     .G                  bit   0,a            ; BUSY signal?
3AC8  20F1      .                  jr    nz,$-13        ; Yes, wait
3ACA  F1       .                   pop   af             ; Restore character
3ACB  D30E     ..                  out   (0x0E),a       ; Output byte to printer port 0x0E
3ACD  D30D     ..                  out   (0x0D),a       ; Send strobe to printer port 0x0D
3ACF  FE0D     ..                  cp    0x0D           ; Carriage return (0x0D)?
3AD1  37       7                   scf                  ; Set Carry
3AD2  3F       ?                   ccf                  ; Complement Carry (clear it)
3AD3  C0       .                   ret   nz             ; Return if not CR
3AD4  3E0A     >.                  ld    a,0x0A         ; Send line feed (0x0A)
3AD6  18E2     ..                  jr    $-28           ; Output LF to printer
                     ; Output character - handle block graphics or inverted
3AD8  CB77     .w                  bit   6,a            ; Is bit 6 set? (inverted character)
3ADA  CA732C   .s,                 jp    z,PRN_GFX_CHAR ; No, it is block graphics - output via PRN_
3ADD  E63F     .?                  and   0x3F           ; Clear bits 6 and 7
3ADF  C35639   .V9                 jp    PRN_INV_CHAR   ; Output inverted character
                     ; Output carriage return to printer
3AE2  3E0D     >.                  ld    a,0x0D         ; Load CR code (0x0D)
3AE4  CDBA3A   ..:                 call  PRN_CHAR_OUT   ; Send CR to printer
3AE7  C9       .                   ret                  ; Return
                     ; Check if BREAK key is pressed. Output: Carry=1 if BREAK pressed.
3AE8  B7       .                   or    a              ; Clear Carry flag
3AE9  3AFD68   :.h                 ld    a,(0x68FD)     ; Load keyboard row 2 (port 0x68FD)
3AEC  CB57     .W                  bit   2,a            ; Is CTRL key pressed?
3AEE  C0       .                   ret   nz             ; No, return (not pressed)
3AEF  3ADF68   :.h                 ld    a,(0x68DF)     ; Load keyboard row 6 (port 0x68DF)
3AF2  37       7                   scf                  ; Set Carry flag
3AF3  CB57     .W                  bit   2,a            ; Test bit 2 (BREAK key)
3AF5  C8       .                   ret   z              ; BREAK pressed? Return with Carry set
3AF6  3F       ?                   ccf                  ; Not BREAK, clear Carry
3AF7  C9       .                   ret                  ; Return
                     ; Check BREAK key; if pressed, stop execution and return to BASIC
3AF8  CDE83A   ..:                 call  CHECK_BREAK    ; Check BREAK key
3AFB  D0       .                   ret   nc             ; Not pressed, return
3AFC  E1       .                   pop   hl             ; Pop return address (discard)
3AFD  E1       .                   pop   hl             ; Pop caller's return address (discard)
3AFE  3A3978   :9x                 ld    a,(FLAG2)      ; Load Flag 2
3B01  E6B7     ..                  and   0xB7           ; Clear CRUN and VERIFY flags (AND with 0xB7
3B03  323978   29x                 ld    (FLAG2),a      ; Save updated Flag 2
3B06  3E01     >.                  ld    a,0x01         ; A = 1 (flag for BREAK)
3B08  FB       .                   ei                   ; Enable interrupts
3B09  C3A01D   ...                 jp    0x1DA0         ; Jump to BASIC error handler
                     ; Wait until screen output buffer is fully flushed
3B0C  3A9C78   :.x                 ld    a,(0x789C)     ; Load device type
3B0F  B7       .                   or    a              ; Is it 0 (screen)?
3B10  C26421   .d!                 jp    nz,PRINT_NEXT  ; No, return immediately
3B13  3AAF7A   :.z                 ld    a,(0x7AAF)     ; Load output buffer counter
3B16  B7       .                   or    a              ; Buffer empty (= 0)?
3B17  20FA      .                  jr    nz,$-4         ; No, keep waiting
3B19  C36421   .d!                 jp    PRINT_NEXT     ; Return to PRINT_NEXT
                     ; If output buffer is empty, load cursor column position
3B1C  3AAF7A   :.z                 ld    a,(0x7AAF)     ; Load output buffer counter
3B1F  B7       .                   or    a              ; Buffer empty?
3B20  C0       .                   ret   nz             ; No, return
3B21  3AA678   :.x                 ld    a,(TTYPOS)     ; Load cursor column position (TTYPOS)
3B24  C9       .                   ret                  ; Return
                     ; *******************************
                     ; Output interruption during LIST output
                     ; *******************************
3B25  21EF68   !.h                 ld    hl,0x68EF      ; Address keyboard row 4
3B28  CB66     .f                  bit   4,(hl)         ; SPACE key pressed?
3B2A  2018      .                  jr    nz,$+26        ; No!
3B2C  CD483B   .H;                 call  DEBOUNCE_DELAY ; Debounce key
3B2F  CB66     .f                  bit   4,(hl)         ; Wait until key is released
3B31  28FC     (.                  jr    z,$-2
3B33  CD483B   .H;                 call  DEBOUNCE_DELAY ; Debounce key
3B36  CDF83A   ..:                 call  CHECK_BREAK_STOP ; BREAK key pressed?
3B39  CB66     .f                  bit   4,(hl)         ; No, SPACE key pressed again?
3B3B  20F9      .                  jr    nz,$-5         ; No, keep waiting
3B3D  CD483B   .H;                 call  DEBOUNCE_DELAY ; Debounce key
3B40  CB66     .f                  bit   4,(hl)         ; Wait until key is released
3B42  28FC     (.                  jr    z,$-2
3B44  21FFFF   !..                 ld    hl,0xFFFF      ; Current line number = direct command
3B47  C9       .                   ret                  ; Done!
                     ; Debounce key
3B48  21FF07   !..                 ld    hl,0x07FF      ; Counter for wait loop
3B4B  2B       +                   dec   hl             ; Counter - 1
3B4C  7D       }                   ld    a,l
3B4D  B4       .                   or    h
3B4E  20FB      .                  jr    nz,$-3         ; No, keep counting
3B50  21EF68   !.h                 ld    hl,0x68EF      ; Address keyboard row 4
3B53  C9       .                   ret                  ; Done!
                     ; *******************************
                     ; When PRINT# outputs data to cassette
                     ; *******************************
3B54  CD1135   ..5                 call  TAPE_WRITE_BYTE ; Write byte to cassette
3B57  C9       .                   ret   
                     ; *******************************
                     ; When PRINT# writes header to cassette
                     ; *******************************
3B58  F3       .                   di                   ; Disable interrupts
3B59  23       #                   inc   hl             ; Program pointer + 1
3B5A  0EF2     ..                  ld    c,0xF2         ; Load identifier for data
3B5C  CD5835   .X5                 call  TAPE_WRITE_LEADER_NAME ; Output sync bytes, leader, identifier, and
3B5F  DAFE3A   ..:                 jp    c,0x3AFE       ; BREAK! End
3B62  2B       +                   dec   hl             ; Program pointer - 1
3B63  CF       .                   rst   8              ; Is filename terminated with quote-characte
3B64  22       "                   DEFB  0x22           ; Comparison literal: quote-character
3B65  CF       .                   rst   8              ; Is that followed by a comma?
3B66  2C       ,                   DEFB  0x2C           ; Comparison literal: comma
3B67  C9       .                   ret   
                     ; *******************************
                     ; When INPUT# reads header and filename from cassette
                     ; *******************************
3B68  F3       .                   di                   ; Disable interrupts
3B69  23       #                   inc   hl             ; Program pointer + 1
3B6A  CD8C35   ..5                 call  TAPE_BUFFER_NAME ; Read in the filename
3B6D  2B       +                   dec   hl             ; Program pointer - 1
3B6E  CF       .                   rst   8              ; Is name terminated with quote-character?
3B6F  22       "                   DEFB  0x22           ; Comparison literal: quote-character
3B70  CF       .                   rst   8              ; Is that followed by a comma?
3B71  2C       ,                   DEFB  0x2C           ; Comparison literal: comma
3B72  E5       .                   push  hl             ; Yes, push program pointer onto stack
3B73  CDB135   ..5                 call  TAPE_PREPARE_MESSAGES ; Prepare message output
3B76  214238   !B8                 ld    hl,0x3842      ; Address the 'WAITING' text
3B79  CDF437   ..7                 call  TAPE_PRINT_MSG ; and output it
3B7C  CDE735   ..5                 call  0x35E7         ; Search for file on cassette
3B7F  3AD27A   :.z                 ld    a,(SOUND_NOTE_VALUE) ; Load file identifier
3B82  FEF2     ..                  cp    0xF2           ; Correct for data?
3B84  20F6      .                  jr    nz,$-8         ; No, keep searching
3B86  E1       .                   pop   hl             ; Yes, restore program pointer
3B87  C9       .                   ret                  ; Done!
                     ; *******************************
                     ; When INPUT# reads data from cassette
                     ; *******************************
3B88  CD7537   .u7                 call  TAPE_READ_BYTE ; Read byte from cassette
3B8B  FE0D     ..                  cp    0x0D           ; End of record?
3B8D  C0       .                   ret   nz             ; No, return
3B8E  F5       .                   push  af             ; Save character on stack
3B8F  CDF920   ..                  call  PRINT_BOL_CHECK ; Output CR/LF
3B92  F1       .                   pop   af             ; Reload character
3B93  C9       .                   ret                  ; Done!
