      141A13FE ....  
0199  2028FAFE  (..                DEFB  0x20,0x28,0xFA,0xFE
                     ; Parameter / Coordinate Parsing (for Graphics?)
019D  D7       .                   rst   0x10           ; Get next character (RST 10H)
019E  E5       .                   push  hl             ; Save pointer
019F  3A9978   :.x                 ld    a,(0x7899)     ; Get RAM byte 7899H
01A2  B7       .                   or    a              ; Zero?
01A3  2006      .                  jr    nz,$+8         ; No, skip next part
01A5  CD5803   .X.                 call  KBD_QUERY_WRAP ; Call 0358H
01A8  B7       .                   or    a              ; Zero?
01A9  2811     (.                  jr    z,$+19         ; Yes, skip ahead
01AB  F5       .                   push  af
01AC  AF       .                   xor   a
01AD  329978   2.x                 ld    (0x7899),a
01B0  3C       <                   inc   a
01B1  CD5728   .W(                 call  0x2857         ; Call STRINI (2857H)
01B4  F1       .                   pop   af
01B5  2AD478   *.x                 ld    hl,(0x78D4)    ; Get 78D4H
01B8  77       w                   ld    (hl),a
01B9  C38428   ..(                 jp    0x2884         ; Jump to 2884H
01BC  212819   !(.                 ld    hl,0x1928      ; Load 1928H into 7921H
01BF  222179   "!y                 ld    (FACLO),hl
01C2  3E03     >.                  ld    a,0x03         ; Set 78AFH to 3
01C4  32AF78   2.x                 ld    (VALTYP),a
01C7  E1       .                   pop   hl             ; Restore HL
01C8  C9       .                   ret                  ; Return
                     ; Clear Screen and Home Cursor
                     CLRSCR_HOME:
01C9  3E1C     >.                  ld    a,0x1C         ; Clear screen (1CH)
01CB  CD3A03   .:.                 call  SCREEN_OUT_CHAR
01CE  3E1F     >.                  ld    a,0x1F         ; Move cursor home (1FH)
01D0  C33A03   .:.                 jp    SCREEN_OUT_CHAR
