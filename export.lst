                     ; *******************************
                     ; Output error message
3CD4  CB3B     .;                  srl   e              ; Error number / 2
3CD6  1C       .                   inc   e              ; + 1
3CD7  7E       ~                   ld    a,(hl)         ; Load byte from error table
3CD8  23       #                   inc   hl             ; Table address + 1
3CD9  B7       .                   or    a              ; New message?
3CDA  F2D73C   ..<                 jp    p,0x3CD7       ; No!
3CDD  1D       .                   dec   e              ; Error number - 1 = 0?
3CDE  20F7      .                  jr    nz,$-7         ; No, not the right message
3CE0  E67F     ..                  and   0x7F           ; Clear bit 7
3CE2  CD2A03   .*.                 call  CHAR_OUTPUT_DISPATCH ; Output byte
3CE5  7E       ~                   ld    a,(hl)         ; Load next byte from error table
3CE6  23       #                   inc   hl             ; Table address + 1
3CE7  B7       .                   or    a              ; New message?
3CE8  F2E23C   ..<                 jp    p,0x3CE2       ; No, output byte
3CEB  C9       .                   ret                  ; Yes, done
