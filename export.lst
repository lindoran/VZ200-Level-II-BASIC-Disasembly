1532  EB       .                   ex    de,hl          ; Transfer to Y
1533  0680     ..                  ld    b,0x80         ; Exp. Y = 0, so that it's between 0 and 1
1535  212579   !%y                 ld    hl,0x7925      ; Set sign flag
1538  70       p                   ld    (hl),b         ; Result = positive
1539  2B       +                   dec   hl             ; Exponent X = Exponent Y
153A  70       p                   ld    (hl),b
153B  4F       O                   ld    c,a            ; MSB in C
153C  0600     ..                  ld    b,0x00         ; Clear LSB
