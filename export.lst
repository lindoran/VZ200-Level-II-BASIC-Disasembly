                     ; Subroutine for FOR/NEXT and GOSUB/RETURN
                     ; retrieves data back from the stack
                     STACK_RECOVERY:
1936  210400   !..                 ld    hl,0x0004      ; Stack pointer + 4 into HL
1939  39       9                   add   hl,sp          ; (bypass 2 return addresses)
193A  7E       ~                   ld    a,(hl)         ; Load flag
193B  23       #                   inc   hl
193C  FE81     ..                  cp    0x81           ; Data from FOR loop?
193E  C0       .                   ret   nz             ; no, finished
193F  4E       N                   ld    c,(hl)         ; yes, load loop variable address
1940  23       #                   inc   hl
1941  46       F                   ld    b,(hl)
1942  23       #                   inc   hl
1943  E5       .                   push  hl             ; on stack
1944  69       i                   ld    l,c            ; loop variable in HL
1945  60       `                   ld    h,b
1946  7A       z                   ld    a,d
1947  B3       .                   or    e              ; loop variable specified?
1948  EB       .                   ex    de,hl          ; no, return with address in DE
1949  2802     (.                  jr    z,$+4
194B  EB       .                   ex    de,hl
194C  DF       .                   rst   0x18           ; yes, = found loop variable?
194D  010E00   ...                 ld    bc,0x000E      ; 14 in BC
1950  E1       .                   pop   hl             ; Reload address pointer
1951  C8       .                   ret   z              ; yes, finished
1952  09       .                   add   hl,bc          ; Pointer to next stack data
1953  18E5     ..                  jr    $-25           ; same once more
                     ; Make space for program line to be inserted
                     ; or free up variable
                     MAKE_SPACE:
1955  CD6C19   .l.                 call  0x196C         ; is HL still in free memory?
1958  C5       .                   push  bc             ; no, OUT OF MEMORY - Error
1959  E3       .                   ex    (sp),hl        ; Swap HL and BC
195A  C1       .                   pop   bc
195B  DF       .                   rst   0x18           ; Start of source block reached?
195C  7E       ~                   ld    a,(hl)         ; Relocate 1 byte
195D  02       .                   ld    (bc),a
195E  C8       .                   ret   z              ; yes, finished!
195F  0B       .                   dec   bc             ; Address pointer - 1
1960  2B       +                   dec   hl
1961  18F8     ..                  jr    $-6            ; next byte
                     ; Test if 2*C bytes are free
                     ; if not, OUT OF MEMORY - Error
                     CHECK_FREE_MEMORY:
1963  E5       .                   push  hl             ; HL onto stack
1964  2AFD78   *.x                 ld    hl,(STREND)    ; Starting address of free memory
1967  0600     ..                  ld    b,0x00         ; B=0
1969  09       .                   add   hl,bc          ; Add BC to HL twice
196A  09       .                   add   hl,bc
196B  3EE5     >.                  ld    a,0xE5         ; LD A,0E5H Dummy instruction
196D  3EC6     >.                  ld    a,0xC6         ; HL > FFC6H ?
196F  95       .                   sub   l
1970  6F       o                   ld    l,a
1971  3EFF     >.                  ld    a,0xFF
1973  9C       .                   sbc   a,h
1974  3804     8.                  jr    c,$+6          ; yes, OUT OF MEMORY - Error
1976  67       g                   ld    h,a
1977  39       9                   add   hl,sp          ; HL + 4A >= SP ?
1978  E1       .                   pop   hl             ; Restore HL
1979  D8       .                   ret   c              ; no, return
