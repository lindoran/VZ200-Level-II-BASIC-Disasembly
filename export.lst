; z80bench listing — .
;
; ADDR   BYTES     ASCII  LABEL         MNEM  OPERANDS COMMENT
;

                     ; Initialisation of the computer
                     START:
0000  F3       .                   di                   ; Test Start
0001  AF       .                   xor   a              ; Clear A (color index 0)
0002  320068   2.h                 ld    (0x6800),a     ; Set background color (black)
0005  C37406   .t.                 jp    BASIC_INIT_1   ; Jump to RESET part 1 (at 0674H)
                     ;
                     ; *****************************************************************
                     RST08_VEC:
0008  C30078   ..x                 jp    0x7800         ; RST 08H: Jump to RAM hook at 7800H (SYNCHR
                     ;
                     ; Not used in VZ200
000B  E1       .                   pop   hl             ; Pop return address to HL
000C  E9       .                   jp    (hl)           ; Jump to HL (return to caller)
000D  000000   ...                 DEFB  0x00,0x00,0x00 ; unused
                     ; Restart 10
0010  C30378   ..x                 jp    0x7803         ; Jump via RAM vector 7803H to address 1D78H
                     ; Read a character via Device Control Block (DCB)
0013  C5       .                   push  bc             ; Save BC
0014  0601     ..                  ld    b,0x01         ; Set B for DCB check
0016  182E     ..                  jr    $+48           ; to DCB call routine
                     ; Restart 18
0018  C30678   ..x                 jp    0x7806         ; Jump via RAM vector 7806H to address 1C90H
                     ; Output a character via Device Control Block (DCB)
001B  C5       .                   push  bc             ; Save BC
001C  0602     ..                  ld    b,0x02         ; Set B for DCB check
001E  1826     .&                  jr    $+40           ; to DCB call routine
                     ; Restart 20
0020  C30978   ..x                 jp    0x7809         ; Jump via RAM vector 7809H to address 25D9H
0023  C5       .                   push  bc             ; not used
0024  0604     ..                  ld    b,0x04
0026  181E     ..                  jr    $+32
                     ; Restart 28
0028  C30C78   ..x                 jp    0x780C         ; Jump to RAM vector 780CH
                     ; Keyboard query
                     ; On return, Reg. A contains the ASCII code of a pressed key, or 0 if none 
                     ; pressed.
002B  111578   ..x                 ld    de,0x7815      ; Load DCB address for keyboard
002E  18E3     ..                  jr    $-27           ; continue at 13H
                     ; Restart 30
0030  C30F78   ..x                 jp    0x780F         ; Jump to RAM vector 780FH
                     ; Screen output via DCB
                     ; Not used on LASER 110-310.
0033  111D78   ..x                 ld    de,0x781D      ; Load DCB address
0036  18E3     ..                  jr    $-27           ; continue at 1BH
                     ; Restart 38 - Interrupt vector for IM1
0038  C3B82E   ...                 jp    0x2EB8         ; to Interrupt Service Routine
                     ; Printer output via Device Control Block (DCB)
                     ; Reg. A must contain the character to be output
003B  112578   .%x                 ld    de,0x7825      ; Load DCB address
003E  18DB     ..                  jr    $-35           ; continue at 1BH
0040  C3FD2E   ...                 jp    0x2EFD         ; to keyboard read routine
0043  C9       .                   ret                  ; not used
0044  0000     ..                  DEFB  0x00,0x00      ; unused
0046  C3C203   ...                 jp    DCB_DISPATCH   ; Jump to DCB call routine
                     ; Keyboard query
                     ; waits until a key is pressed.
                     ; Output: A-reg contains ASCII code of the pressed key
0049  CD2B00   .+.                 call  KBD_QUERY      ; Evaluate keyboard
004C  B7       .                   or    a              ; Key pressed?
004D  C0       .                   ret   nz             ; Yes, return
004E  18F9     ..                  jr    $-5            ; no, wait
                     ; Save character from cursor position
0050  2A2078   * x                 ld    hl,(0x7820)    ; Load cursor address
0053  7E       ~                   ld    a,(hl)         ; Load character
0054  323C78   2<x                 ld    (0x783C),a     ; save to 783CH
0057  C9       .                   ret   
0058  4CFE5420 L.T                 DEFB  0x4C,0xFE,0x54,0x20,0xD6,0xFD,0x21,0xF1 ; not used
      D6FD21F1 ..!.  
0060  0B       .                   dec   bc
0061  78       x                   ld    a,b            ; B = 0?
0062  B1       .                   or    c              ; C = 0?
0063  20FB      .                  jr    nz,$-3         ; No, continue loop
0065  C9       .                   ret                  ; Yes, return
                     ; Interupt vector for 'Non maskable interrupts'
                     NMI_VEC:
0066  310006   1..                 ld    sp,0x0600      ; Set stack pointer to 6000H
0069  3AEC68   :.h                 ld    a,(0x68EC)     ; Load latch byte from 68ECH
006C  3C       <                   inc   a              ; Increment A
006D  FE02     ..                  cp    0x02           ; CP 2
006F  D20000   ...                 jp    nc,START       ; Jump if NC to cold start (0000H)
0072  C3CC06   ...                 jp    0x06CC         ; Jump to warm start (06CCH)
                     ; BASIC initialisation part 2
                     BASIC_INIT_2:
0075  118078   ..x                 ld    de,FDIVC       ; Destination: 7880H (RAM hooks)
0078  21F718   !..                 ld    hl,FDIV_HELPER_ROM ; Source: 18F7H
007B  012700   .'.                 ld    bc,0x0027      ; Length: 27H bytes
007E  EDB0     ..                  ldir                 ; Copy routines to RAM
                     ; Set up I/O buffer
                     INIT_IO_BUF:
0080  21E579   !.y                 ld    hl,0x79E5      ; Load I/O buffer start (79E5H)
0083  363A     6:                  ld    (hl),0x3A      ; Store ':' prompt
0085  23       #                   inc   hl             ; Increment HL
0086  70       p                   ld    (hl),b         ; Store character from B
0087  23       #                   inc   hl             ; Increment HL
0088  362C     6,                  ld    (hl),0x2C      ; Store ',' character
008A  23       #                   inc   hl             ; Increment HL
008B  22A778   ".x                 ld    (0x78A7),hl    ; Save I/O buffer pointer to 78A7H
                     ; Initialisation of the DOS error hooks (RAM: 7952H)
                     INIT_DOS_HOOKS:
008E  112D01   .-.                 ld    de,ERROR_L3    ; Address of L3 error handler (012DH)
0091  061C     ..                  ld    b,0x1C         ; 28 DOS commands to initialize
0093  215279   !Ry                 ld    hl,0x7952      ; RAM hook table address (7952H)
                     INIT_DOS_LOOP:
0096  36C3     6.                  ld    (hl),0xC3      ; Store JP opcode (0xC3)
0098  23       #                   inc   hl             ; Increment RAM pointer
0099  73       s                   ld    (hl),e         ; Low byte of L3 handler
009A  23       #                   inc   hl             ; Increment RAM pointer
009B  72       r                   ld    (hl),d         ; High byte of L3 handler
009C  23       #                   inc   hl             ; Increment RAM pointer
009D  10F7     ..                  djnz  $-7            ; Loop for 28 entries
                     ; Initialisation of the DOS exits with RET (RAM: 79A6H)
                     INIT_DOS_EXITS:
009F  0615     ..                  ld    b,0x15         ; 21 DOS exits to initialize
                     INIT_EXIT_LOOP:
00A1  36C9     6.                  ld    (hl),0xC9      ; Store RET opcode (0xC9)
00A3  23       #                   inc   hl             ; Advance 3 bytes (unused JP slot)
00A4  23       #                   inc   hl
00A5  23       #                   inc   hl
00A6  10F9     ..                  djnz  $-5            ; Loop for 21 entries
                     ; End of BASIC initialisation
                     INIT_BASIC_FINISH:
00A8  21E87A   !.z                 ld    hl,0x7AE8      ; Load start of user RAM (7AE8H)
00AB  70       p                   ld    (hl),b         ; Initialize it to zero
00AC  31F879   1.y                 ld    sp,0x79F8      ; Set temporary stack pointer (79F8H)
00AF  CD8F1B   ...                 call  0x1B8F         ; Initialize stack and variables (STKINI)
00B2  CDC901   ...                 call  CLRSCR         ; Clear screen and home cursor (CLRSCR)
                     ;
                     ; ************************************************************************
                     ; Unused code block / timing delay? falls into next segment
                     ; possbile removed block from TRS-80?
00B5  00000000 ....                DEFB  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00
      00000000 ....  
00BD  00       .                   DEFB  0x00
                     ; Skip memory test
                     SKIP_MEM_TEST:
00BE  1804     ..                  jr    $+6            ; Jump to memory test routine
00C0  D7       .                   rst   0x10
00C1  B7       .                   or    a
00C2  2012      .                  jr    nz,$+20
                     ; Memory test (memory size check)
                     MEM_TEST:
00C4  214C7B   !L{                 ld    hl,0x7B4C      ; Start of RAM check (7B4CH)
                     MEM_TEST_LOOP:
00C7  23       #                   inc   hl             ; Next ram location
00C8  7C       |                   ld    a,h            ; Get MSB
00C9  B5       .                   or    l              ; Get LSB
00CA  281B     (.                  jr    z,$+29         ; End of memory if zero (HIMEM)
00CC  7E       ~                   ld    a,(hl)         ; Get byte from memory
00CD  47       G                   ld    b,a            ; Save original byte in B
00CE  2F       /                   cpl                  ; Complement byte for test
00CF  77       w                   ld    (hl),a         ; Write to memory
00D0  BE       .                   cp    (hl)           ; Check if it was stored correctly
00D1  70       p                   ld    (hl),b         ; Restore original byte
00D2  28F3     (.                  jr    z,$-11         ; Loop back if memory exists
00D4  1811     ..                  jr    $+19
                     ;
                     ; ***********************************************************
                     ; unused code in VZ200 pr. G. Wolf book
                     ;
                     ; Symbol name from Level II listing for TRS 80  
                     ;
                     ; TODO: Document from TRS 80 listing.
                     ; ***********************************************************
                     MEM_SIZE_INPUT:
00D6  CD5A1E   .Z.                 call  DECZ           ; Handle memory size input
00D9  B7       .                   or    a
00DA  C29719   ...                 jp    nz,SYNTAX_ERR_HANDLER
00DD  EB       .                   ex    de,hl
00DE  2B       +                   dec   hl
00DF  3E8F     >.                  ld    a,0x8F
00E1  46       F                   ld    b,(hl)
00E2  77       w                   ld    (hl),a
00E3  BE       .                   cp    (hl)
00E4  70       p                   ld    (hl),b
00E5  20CE      .                  jr    nz,$-48
                     ;
                     ; ***********************************************************
                     ;
                     ; Set end of memory for BASIC
00E7  2B       +                   dec   hl             ; address of the last byte
00E8  11147C   ..|                 ld    de,0x7C14      ; at least 1868 bytes must be free
00EB  DF       .                   rst   0x18           ; check free memory
00EC  DA7A19   .z.                 jp    c,ERROR_ENTRY  ; otherwise: OUT OF MEMORY error (197AH)
00EF  11CEFF   ...                 ld    de,0xFFCE      ; DE = -50 (FFCE is 2s comp. -50)
00F2  22B178   ".x                 ld    (0x78B1),hl    ; store end-of-memory address (@ 78B1H)
00F5  19       .                   add   hl,de          ; HL = end of memory - 50
00F6  22A078   ".x                 ld    (0x78A0),hl    ; = start of string space - 1
                     INIT_VARS_2:
00F9  CD4D1B   .M.                 call  0x1B4D         ; call the NEW routine (1B4DH)
00FC  CD8434   ..4                 call  0x3484         ; initialize counters and pointers (3484H)
00FF  210F01   !..                 ld    hl,0x010F      ; Load banner string address (010FH)
0102  CDA728   ..(                 call  OUTSTR         ; Print banner string (OUTSTR)
0105  ED56     .V                  im    1              ; Set Interrupt Mode 1
0107  C38E06   ...                 jp    BASIC_INIT_3   ; Jump to memory expansion check (068EH)
010A  007E23FE .~#.                DEFB  0x00,0x7E,0x23,0xFE,0x0D,0x56,0x49,0x44 ; Artifact? No caller
      0D564944 .VID  
0112  454F2054 EO T                DEFB  0x45,0x4F,0x20,0x54,0x45,0x43,0x48,0x4E
      4543484E ECHN  
011A  4F4C4F47 OLOG                DEFB  0x4F,0x4C,0x4F,0x47,0x59,0x0D,0x42,0x41
      590D4241 Y.BA  
0122  53494320 SIC                 DEFB  0x53,0x49,0x43,0x20,0x56,0x32,0x2E,0x30
      56322E30 V2.0  
012A  0D0D00   ...                 DEFB  0x0D,0x0D,0x00 ; term with 00
                     ; L3 Error Handler (?L3 ERROR)
                     ERROR_L3:
012D  1E2C     .,                  ld    e,0x2C         ; Load error code 44 (L3 Error)
012F  C3A219   ...                 jp    ERROR_HANDLER  ; Jump to main error handler
                     ; GRAPHICS ROUTINE - Common Code for SET, RESET and POINT
                     ; A will be 0 for POINT, 80H for SET and 1 for RESET.
                     POINT:
0132  D7       .                   rst   0x10           ; Get next character (RST 10H)
0133  AF       .                   xor   a              ; A = 0 (POINT flag)
0134  01       .                   DEFB  0x01           ; Skip LD A,n (01 matches LD BC,nn)
                     SET:
0135  3E80     >.                  ld    a,0x80         ; A = 80H (SET flag)
0137  01       .                   DEFB  0x01           ; Skip LD A,n
                     RESET:
0138  3E01     >.                  ld    a,0x01         ; A = 1 (RESET flag)
013A  F5       .                   push  af             ; Save command flag (POINT/SET/RESET)
013B  CF       .                   rst   8              ; Expect '(' (RST 08H)
013C  28CD     (.                  jr    z,$-49         ; JR Z, 010BH (GETBYT?)
013E  1C       .                   inc   e              ; INC E
013F  2B       +                   dec   hl             ; DEC HL
0140  FE80     ..                  cp    0x80           ; X < 128?
0142  D24A1E   .J.                 jp    nc,0x1E4A      ; JP NC, FCERR (1E4AH)
0145  F5       .                   push  af             ; Save X
0146  CF       .                   rst   8              ; Expect ',' (RST 08H)
0147  2C       ,                   inc   l              ; INC L
0148  CD1C2B   ..+                 call  0x2B1C         ; Call GETBYT (2B1CH?)
014B  FE40     .@                  cp    0x40           ; Y < 64?
014D  D24A1E   .J.                 jp    nc,0x1E4A      ; JP NC, FCERR (1E4AH)
0150  5F       _                   ld    e,a            ; E = Y
0151  AF       .                   xor   a              ; A = 0
0152  57       W                   ld    d,a            ; D = 0
0153  EB       .                   ex    de,hl          ; DE <-> HL (HL = Y)
0154  29       )                   add   hl,hl          ; Y * 2
0155  29       )                   add   hl,hl          ; Y * 4
0156  29       )                   add   hl,hl          ; Y * 8
0157  29       )                   add   hl,hl          ; Y * 16
0158  29       )                   add   hl,hl          ; Y * 32
0159  EB       .                   ex    de,hl          ; DE <-> HL (DE = Y * 32)
015A  F1       .                   pop   af             ; Get X
015B  F5       .                   push  af             ; Save X
015C  CB3F     .?                  srl   a              ; X / 2
015E  CB3F     .?                  srl   a              ; X / 4
0160  83       .                   add   a,e            ; A = X/4 + (Y*32 mod 256)
0161  5F       _                   ld    e,a            ; E = A
0162  7A       z                   ld    a,d            ; A = D (high byte of Y*32)
0163  F670     .p                  or    0x70           ; OR 70H (Video RAM starts at 7000H)
0165  57       W                   ld    d,a            ; D = A (DE = 7000H + Y*32 + X/4)
0166  F1       .                   pop   af             ; Get X again
0167  E603     ..                  and   0x03           ; X AND 03H (pixel position in byte)
0169  87       .                   add   a,a            ; A = pixel * 2
016A  47       G                   ld    b,a            ; B = A
016B  F1       .                   pop   af             ; Get original command flag (POINT/SET/RESET
016C  B7       .                   or    a              ; Is it POINT (0)?
016D  CAE738   ..8                 jp    z,0x38E7       ; Yes, JP to POINT routine (38E7H)
0170  F5       .                   push  af             ; Save Command flag
0171  0E3F     .?                  ld    c,0x3F         ; C = 3FH (Graphics mask?)
0173  3A4678   :Fx                 ld    a,(0x7846)     ; Get color mode latch?
0176  CB27     .'                  sla   a              ; SLA A
0178  CB27     .'                  sla   a              ; SLA A
017A  CB0F     ..                  rrc   a              ; RRC A
017C  CB09     ..                  rrc   c              ; RRC C
017E  10FA     ..                  djnz  $-4            ; DJNZ hBc2 (Shift bit into position)
0180  C30339   ..9                 jp    0x3903         ; JP to rest of SET/RESET (3903H)
                     ; Set cursor to 7839H and reset bit 3
0183  213978   !9x                 ld    hl,0x7839      ; Load 7839H (Cursor flags?)
0186  CB9E     ..                  res   3,(hl)         ; Reset bit 3
0188  218403   !..                 ld    hl,0x0384      ; Load address of 'ERROR' message
018B  CDA728   ..(                 call  OUTSTR         ; Print string (OUTSTR)
018E  C3CF36   ..6                 jp    0x36CF         ; Jump to 36CFH
