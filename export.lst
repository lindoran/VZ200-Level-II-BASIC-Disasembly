197E  2AA278   *.x                 ld    hl,(0x78A2)    ; Load line number
1981  7C       |                   ld    a,h            ; in direct mode? (=FFFF)
1982  A5       .                   and   l
1983  3C       <                   inc   a
1984  2808     (.                  jr    z,$+10         ; no, jump to END
1986  3AF278   :.x                 ld    a,(0x78F2)     ; Trap flag set?
1989  B7       .                   or    a
198A  1E22     ."                  ld    e,0x22         ; NO RESUME - Load error code
198C  2014      .                  jr    nz,$+22        ; yes, to message output
198E  C3C11D   ...                 jp    0x1DC1         ; Jump to END
