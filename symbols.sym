; [JUMP_LABEL]
BASIC_INIT_2     EQU     0x0075      ;                                                                                                                                                                                                                                                                                                                                                                                                                        BASIC initialization part 2
INIT_IO_BUF      EQU     0x0080      ;                                                                                                                                                                                                                                                                                                                                                                                                             Setup I/O buffer
ERROR_L3         EQU     0x012D      ;                                                                                                                                                                                                                                                                                                                                                L3 error handler entry

; [ROM_CALL]
CLRSCR           EQU     0x01C9      ;                                                                                                                                                                                                                                                                                                                                             Clear screen and home cursor
CHRGOT           EQU     0x010B      ;                                                                                                                                                                                                                                                                              CHRGOT routine (TRS-80 compatible)
ROMRET           EQU     0x000B      ;                                                                                                                                                                                                                                                                         Simple POP HL / JP (HL) return
CLRSCR_HOME      EQU     0x01C9      ;                                                                                                                                                                                                                                               Clear screen and move cursor home
