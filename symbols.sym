RST28_VEC        EQU     0x0028      ;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          

; [ROM_CALL]
KBD_QUERY        EQU     0x002B      ;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     Keybo

; [VECTOR]
RST30_VEC        EQU     0x0030      ;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  RST 30H 

; [ROM_CALL]
SCR_OUT_DCB      EQU     0x0033      ;                                                                                                                                                                                                                                                                                                                                                                                                                                                                             Screen output

; [VECTOR]
RST38_VEC        EQU     0x0038      ;                                                                                                                                                                                                                                                                                                                                                                                                                                                                          RST 38H Vector

; [ROM_CALL]
PRN_OUT_DCB      EQU     0x003B      ;                                                                                                                                                                                                                                                                                                                                                                                                                                                                     Printer output via DC

; [JUMP_LABEL]
DCB_CALL         EQU     0x0046      ;                                                                                                                                                                                                                                                                                                                                                                                                                                                               DCB call dispatcher

; [ROM_CALL]
KBD_WAIT         EQU     0x0049      ;                                                                                                                                                                                                                                                                                                                                                                                                                                                        Wait for keypress
GET_CURSOR_CHAR  EQU     0x0050      ;                                                                                                                                                                                                                                                                                                                                                                                                                                                 Get character at cursor
DELAY_LOOP       EQU     0x0060      ;                                                                                                                                                                                                                                                                                                                                                                                                                                        Delay loop

; [VECTOR]
